def mostrar_uso() -> None:
    nome = os.path.basename(sys.argv[0])
    print(f"Uso: {nome} [--porta DISPOSITIVO]\n")
    print("Abre uma interface para ajustar ao vivo o PID do robô equilibrista pela USB.")
    print("Os valores enviados ficam guardados e voltam na próxima vez que o programa abrir;")
    print("ao conectar, o último envio é reaplicado no robô (o Nano reinicia ao abrir a porta).\n")
    print("  --porta DISPOSITIVO   usa esta porta, ex.: /dev/ttyUSB0 (padrão: a última usada ou a primeira encontrada)")
    print("  --help, -h            mostra esta ajuda\n")
    print(f"Último envio guardado em: {ARQUIVO_DO_ULTIMO_ENVIO}")


def erro_de_uso(texto: str) -> None:
    print(pintar(ERRO, "Erro: ") + texto, file=sys.stderr)
    sys.exit(2)


def principal() -> None:
    argumentos = sys.argv[1:]
    porta = None
    while argumentos:
        argumento = argumentos.pop(0)
        if argumento in ("--help", "-h"):
            mostrar_uso()
            return
        if argumento == "--porta":
            if not argumentos:
                erro_de_uso("--porta precisa de um dispositivo, ex.: --porta /dev/ttyUSB0")
            porta = argumentos.pop(0)
        elif argumento.startswith("--porta="):
            porta = argumento.split("=", 1)[1]
        else:
            erro_de_uso(f"argumento desconhecido: '{argumento}'. Consulte {os.path.basename(sys.argv[0])} --help.")

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        erro_de_uso("a interface precisa ser executada em um terminal.")

    AjusteDoPid(porta).executar()


if __name__ == "__main__":
    principal()
