# =============================================================================
#  CONFIGURAÇÃO
# =============================================================================

VELOCIDADE_DA_SERIAL = termios.B115200          # a mesma do Serial.begin() no sketch
PADROES_DE_PORTA = ("/dev/ttyUSB*", "/dev/ttyACM*")

PASTA_DE_CONFIGURACAO = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "pid-robot"
ARQUIVO_DO_ULTIMO_ENVIO = PASTA_DE_CONFIGURACAO / "ultimo-envio.json"

# Quando o programa abre a porta, o Nano reinicia (o sinal DTR da USB faz isso).
# Ele leva ~1 s no bootloader e ~2 s calibrando o giroscópio antes de responder.
SEGUNDOS_ATE_PEDIR_VALORES = 4.0
SEGUNDOS_ENTRE_PEDIDOS_DE_VALORES = 3.0
SEGUNDOS_ENTRE_TENTATIVAS_DE_CONEXAO = 1.5
SEGUNDOS_ENTRE_COMANDOS = 0.08       # espaço entre comandos, para não lotar o buffer do Nano
SEGUNDOS_DE_PAUSA_NO_ENVIO_AUTOMATICO = 0.25
SEGUNDOS_ATE_A_TELEMETRIA_FICAR_VELHA = 1.5
SEGUNDOS_AGUARDANDO_CONFIRMACAO = 1.0

LIMITE_DO_ANGULO_DE_EQUILIBRIO = 35.0
INTERVALO_ENTRE_AMOSTRAS_DO_SKETCH = 0.005   # 200 amostras por segundo, como no sketch
LARGURA_DA_BARRA = 21                # ímpar, para existir um centro exato


@dataclass(frozen=True)
class Parametro:
    nome: str                        # o mesmo nome do comando no sketch
    titulo: str
    casas_decimais: int              # as mesmas casas que o sketch usa ao imprimir
    passo: float                     # ←/→
    passo_grosso: float              # PgUp/PgDn
    minimo: float
    maximo: float
    inicio_da_barra: float           # faixa desenhada na barra: a faixa útil na prática
    fim_da_barra: float
    centrado: bool                   # barra com zero no meio (valores negativos fazem sentido)
    valor_padrao_do_sketch: float
    explicacao: Callable[[float], str]


PARAMETROS = [
    Parametro("kp", "ganho proporcional", 2, 0.5, 5.0, 0.0, 1000.0, 0.0, 100.0, False, 20.0,
              lambda v: f"1 grau de inclinação vira {v:.1f} de comando no motor"),
    Parametro("ki", "ganho integral", 2, 1.0, 10.0, 0.0, 10000.0, 0.0, 300.0, False, 0.0,
              lambda v: f"1 grau mantido por 1 segundo acumula {v:.1f} de comando"),
    Parametro("kd", "ganho derivativo", 3, 0.05, 0.5, 0.0, 100.0, 0.0, 5.0, False, 0.8,
              lambda v: f"caindo a 100 graus/s vira {v * 100:.0f} de comando"),
    Parametro("angulo_equilibrio", "ângulo de equilíbrio", 2, 0.1, 1.0,
              -LIMITE_DO_ANGULO_DE_EQUILIBRIO, LIMITE_DO_ANGULO_DE_EQUILIBRIO,
              -10.0, 10.0, True, 0.0,
              lambda v: f"o robô tenta ficar parado inclinado {v:+.2f}°"),
    Parametro("pwm_minimo", "PWM mínimo do motor", 0, 1.0, 10.0, 0.0, 254.0, 0.0, 255.0, False, 40.0,
              lambda v: f"qualquer comando começa em {v:.0f} de PWM, para vencer a zona morta"),
    # Os limites de angulo_queda e peso_giroscopio são os mesmos do constrain() no sketch.
    Parametro("angulo_queda", "ângulo de queda", 1, 1.0, 5.0, 5.0, 80.0, 0.0, 80.0, False, 35.0,
              lambda v: f"passou de {v:.0f}° longe do equilíbrio: desliga o motor e espera ser levantado"),
    Parametro("peso_giroscopio", "peso do giroscópio no filtro", 3, 0.005, 0.02, 0.0, 1.0, 0.9, 1.0, False, 0.98,
              lambda v: explicar_peso_do_giroscopio(v)),
]
PARAMETRO_POR_NOME = {parametro.nome: parametro for parametro in PARAMETROS}


def explicar_peso_do_giroscopio(peso: float) -> str:
    mistura = f"{peso * 100:.1f}% giroscópio + {(1 - peso) * 100:.1f}% acelerômetro"
    if peso >= 1.0:
        return f"{mistura}: o acelerômetro nunca corrige, o ângulo vai escorregar"
    # Constante de tempo do filtro complementar: intervalo × peso / (1 − peso).
    constante_de_tempo = INTERVALO_ENTRE_AMOSTRAS_DO_SKETCH * peso / (1 - peso)
    return f"{mistura}: o acelerômetro corrige o ângulo em ~{constante_de_tempo * 1000:.0f} ms"

