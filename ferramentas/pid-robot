@dataclass(frozen=True)
class Parametro:
    nome: str                        # o mesmo nome do comando no sketch
    titulo: str
    casas_decimais: int              # as mesmas casas que o sketch usa ao imprimir
    passo: float                     # ←/→ andam o passo; +/- andam 1/10 dele; PgUp/PgDn, 10 vezes ele
    minimo: float
    maximo: float
    inicio_da_barra: float           # faixa desenhada na barra: a faixa útil na prática
    fim_da_barra: float
    centrado: bool                   # barra com zero no meio (valores negativos fazem sentido)
    valor_padrao_do_sketch: float
    # Recebe o valor e todos os valores da tela; devolve os parágrafos da descrição.
    explicacao: Callable[[float, dict[str, float]], list[str]]
    # Quando só alguns valores existem (escala do acelerômetro: 2, 4, 8, 16),
    # as teclas pulam de um para o outro em vez de somar o passo.
    valores_permitidos: tuple[float, ...] = ()

    @property
    def passo_fino(self) -> float:
        # Um décimo do passo, mas nunca menor que a última casa decimal que o
        # sketch imprime: um ajuste que o robô não consegue mostrar não serve.
        # Por isso, nos valores inteiros (pwm_minimo, divisor, filtro), +/- andam de 1 em 1.
        return max(self.passo / 10, 10 ** -self.casas_decimais)

    @property
    def passo_grosso(self) -> float:
        return self.passo * 10


# Filtro passa-baixas do MPU6050 (datasheet): corte em Hz e atraso em ms.
FILTRO_PASSA_BAIXAS_DO_GIROSCOPIO = {1: (188, 1.9), 2: (98, 2.8), 3: (42, 4.8), 4: (20, 8.3), 5: (10, 13.4), 6: (5, 18.6)}
FILTRO_PASSA_BAIXAS_DO_ACELEROMETRO = {1: (184, 2.0), 2: (94, 3.0), 3: (44, 4.9), 4: (21, 8.5), 5: (10, 13.8), 6: (5, 19.0)}


def segundos_entre_amostras(divisor_de_amostragem: float) -> float:
    # Com o filtro ligado o MPU6050 mede 1000 vezes por segundo por dentro.
    return (1 + divisor_de_amostragem) / 1000


