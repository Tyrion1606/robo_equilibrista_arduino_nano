# =============================================================================
#  PORTA SERIAL (sem pyserial: termios direto)
# =============================================================================

class PortaSerial:
    def __init__(self, caminho: str):
        self.caminho = caminho
        self.resto_da_leitura = b""
        self.descritor = os.open(caminho, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        try:
            # Uso exclusivo: impede que outro programa (o Monitor Serial da IDE,
            # por exemplo) leia a mesma porta e "roube" metade das linhas.
            fcntl.ioctl(self.descritor, termios.TIOCEXCL)

            tty.setraw(self.descritor)
            atributos = termios.tcgetattr(self.descritor)
            atributos[2] |= termios.CLOCAL | termios.CREAD
            atributos[4] = VELOCIDADE_DA_SERIAL
            atributos[5] = VELOCIDADE_DA_SERIAL
            termios.tcsetattr(self.descritor, termios.TCSANOW, atributos)
            termios.tcflush(self.descritor, termios.TCIOFLUSH)
        except BaseException:
            os.close(self.descritor)
            raise

    def ler_linhas_completas(self) -> list[str]:
        """Devolve as linhas que chegaram inteiras. Levanta OSError se a porta sumiu."""
        try:
            dados = os.read(self.descritor, 4096)
        except BlockingIOError:
            return []
        if not dados:
            # select() disse que havia algo para ler e não veio nada: desconectou.
            raise OSError(errno.EIO, "a porta foi fechada")

        self.resto_da_leitura += dados
        *linhas, self.resto_da_leitura = self.resto_da_leitura.split(b"\n")
        return [linha.decode("utf-8", "replace").rstrip("\r") for linha in linhas]

    def escrever_linha(self, texto: str) -> None:
        os.write(self.descritor, (texto + "\n").encode("ascii"))

    def fechar(self) -> None:
        # Tira o uso exclusivo antes de fechar: se outro processo ainda estiver
        # com a porta aberta, o bloqueio ficaria preso e ninguém mais conseguiria abri-la.
        try:
            fcntl.ioctl(self.descritor, termios.TIOCNXCL)
        except OSError:
            pass
        try:
            os.close(self.descritor)
        except OSError:
            pass


