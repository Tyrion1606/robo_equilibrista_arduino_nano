def descrever_peso_do_giroscopio(peso: float, valores: dict[str, float]) -> list[str]:
    intervalo = segundos_entre_amostras(valores["divisor_amostragem"])
    mistura = (f"A cada medição, o ângulo mistura {peso * 100:.1f}% do giroscópio (liso, mas escorrega aos poucos) "
               f"com {(1 - peso) * 100:.1f}% do acelerômetro (nunca escorrega, mas sente trancos e vibração como "
               "se fossem inclinação).")
    if peso >= 1.0:
        velocidade = "Em 1.000 o acelerômetro é ignorado: nada corrige o escorregamento e o ângulo desvia até o robô cair."
    elif peso <= 0.0:
        velocidade = "Em 0.000 só o acelerômetro conta: cada aceleração das rodas aparece como inclinação e o robô treme."
    else:
        constante_de_tempo = intervalo * peso / (1 - peso)
        velocidade = (f"Com {1 / intervalo:.0f} medições por segundo, o acelerômetro corrige o ângulo em ~"
                      f"{constante_de_tempo * 1000:.0f} ms (constante de tempo): movimentos mais rápidos que isso vêm "
                      "do giroscópio; tendências mais lentas, do acelerômetro. Muda junto com o divisor_amostragem.")
    return [
        mistura,
        velocidade,
        "Aumentar (0.99, 0.995): ângulo mais liso e menos afetado pelo motor, mas o escorregamento do giroscópio "
        "demora a ser corrigido e o robô vai 'andando'. Diminuir (0.95): corrige depressa, mas a aceleração das "
        "rodas entra no ângulo e o robô treme.",
    ]


def descrever_divisor_de_amostragem(divisor: float, valores: dict[str, float]) -> list[str]:
    intervalo = segundos_entre_amostras(divisor)
    medicoes_por_segundo = 1 / intervalo
    corte, _ = FILTRO_PASSA_BAIXAS_DO_GIROSCOPIO[int(valores["filtro_passa_baixas"])]
    paragrafos = [
        "Quantas medições por segundo o MPU6050 entrega (registrador SMPLRT_DIV). Por dentro ele mede 1000 vezes "
        f"por segundo e só avisa uma a cada (1 + divisor): agora {medicoes_por_segundo:.0f} por segundo, uma a cada "
        f"{intervalo * 1000:.0f} ms. Cada aviso roda um ciclo inteiro: sensor, filtro, PID e motor.",
        "Diminuir (mais rápido): o PID percebe a queda antes, mas sobra menos tempo para ler o I2C (~1 ms) e "
        f"mandar a telemetria. Aumentar: folga de sobra, mas o motor só é corrigido a cada {intervalo * 1000:.0f} ms; "
        "acima de 10 ms fica difícil equilibrar. Também muda o efeito do peso_giroscopio.",
    ]
    if medicoes_por_segundo < 2 * corte:
        paragrafos.append(
            f"Atenção: com o filtro_passa_baixas em {corte} Hz, medir menos de {2 * corte} vezes por segundo cria "
            "oscilações lentas falsas (aliasing). Diminua o divisor ou suba o filtro.")
    else:
        paragrafos.append(
            f"Combina com o filtro_passa_baixas ({corte} Hz): mede mais que o dobro da maior vibração que o filtro "
            "deixa passar, então nenhuma vibração vira oscilação falsa (aliasing).")
    return paragrafos


def descrever_filtro_passa_baixas(filtro: float, valores: dict[str, float]) -> list[str]:
    corte, atraso = FILTRO_PASSA_BAIXAS_DO_GIROSCOPIO[int(filtro)]
    corte_do_acelerometro, _ = FILTRO_PASSA_BAIXAS_DO_ACELEROMETRO[int(filtro)]
    intervalo_em_ms = segundos_entre_amostras(valores["divisor_amostragem"]) * 1000
    opcoes = " · ".join(f"{n} = {c} Hz/{a} ms" for n, (c, a) in FILTRO_PASSA_BAIXAS_DO_GIROSCOPIO.items())
    return [
        "Filtro digital dentro do MPU6050 (registrador CONFIG), aplicado antes de o Nano ler. Agora: corta o que "
        f"vibra acima de {corte} Hz no giroscópio ({corte_do_acelerometro} Hz no acelerômetro) e atrasa a leitura "
        f"em {atraso} ms, o equivalente a {atraso / intervalo_em_ms:.1f} medição(ões).",
        "Subir (filtro mais forte): tira mais vibração do motor e das engrenagens e limpa o termo D, mas o atraso "
        "cresce; um robô que tomba em 50 a 100 ms passa a ser corrigido com informação velha e oscila. Descer: "
        "resposta mais rápida, porém mais ruído; com kd alto o motor zumbe.",
        f"Opções: {opcoes}.",
    ]


