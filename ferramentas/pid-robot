def descrever_kp(kp: float, valores: dict[str, float]) -> list[str]:
    if kp > 0:
        saturacao = (f"Com {kp:.2f}, 1° de inclinação vira {kp:.1f} de comando e 5° viram {5 * kp:.0f}; "
                     f"a partir de {255 / kp:.1f}° só o P já pede o motor no máximo (255).")
    else:
        saturacao = "Em 0, o P está desligado: a inclinação sozinha não gera nenhuma força."
    return [
        "Reage ao TAMANHO da inclinação: quanto mais longe do ângulo de equilíbrio, mais força no motor, "
        "sempre empurrando as rodas para baixo do robô. É o termo principal: sem ele o robô não se levanta. " + saturacao,
        "Aumentar: reage mais forte e cai menos, mas passa do ponto e começa a balançar para a frente e para trás, "
        "cada vez mais rápido. Diminuir: reações moles; o robô tomba devagar sem conseguir voltar.",
        "Como ajustar: com ki e kd em 0, suba até o robô oscilar sozinho; depois use o kd para amortecer "
        "e, se ainda tremer, tire 10 a 20% do kp.",
    ]


